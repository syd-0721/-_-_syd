      "source": [
        "from tempfile import tempdir\n",
        "a,b,c,d = 0,0,0,0\n",
        "string1 = input(\"请输入任意的一个字符串\")\n",
        "for temi in string1:\n",
        "  if temi.isalpha():\n",
        "    a += 1\n",
        "  elif temi.isdigit():\n",
        "    b += 1\n",
        "  elif temi.isspace():\n",
        "    c += 1\n",
        "  else:\n",
        "    d += 1\n",
        "print(\"英文字符有{}个，数字字符有{}个，空格字符有{}个，其它字符有{}个\".format(a,b,c,d))"
      ]
